[debug] [2026-09-04T16:10:55.635Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/game-again-app/rulesets {"name":"projects/game-again-app/rulesets/41b127e3-1400-4aeb-84e7-9c350472d2ab","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /products/{productId} {\n      allow read: if true;\n      allow write: if false;\n    }\n\n    match /users/{userId} {\n      allow create: if request.auth != null\n        && request.auth.uid == userId\n        && request.resource.data.keys().hasOnly([\n          'id', 'email', 'nome', 'cognome', 'createdAt', 'ultimoAccesso'\n        ])\n        && request.resource.data.id == request.auth.uid\n        && request.resource.data.email == request.auth.token.email\n        && request.resource.data.createdAt == request.time\n        && request.resource.data.ultimoAccesso == request.time\n        && request.resource.data.nome is string\n        && request.resource.data.nome.size() > 0\n        && request.resource.data.cognome is string\n        && request.resource.data.cognome.size() > 0;\n\n      allow read: if request.auth != null && request.auth.uid == userId;\n      allow update: if request.auth != null\n        && request.auth.uid == userId\n        && request.resource.data.id == resource.data.id\n        && request.resource.data.email == resource.data.email\n        && request.resource.data.nome == resource.data.nome\n        && request.resource.data.cognome == resource.data.cognome\n        && request.resource.data.createdAt == resource.data.createdAt\n        && request.resource.data.diff(resource.data).affectedKeys()\n          .hasOnly([\n            'ultimoAccesso', 'ultimoLogout', 'indirizzo', 'cap', 'citta',\n            'provincia', 'stato', 'numeroTelefono'\n          ])\n        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ultimoAccesso'])\n          || request.resource.data.ultimoAccesso == request.time)\n        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ultimoLogout'])\n          || request.resource.data.ultimoLogout == request.time)\n        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['indirizzo'])\n          || request.resource.data.indirizzo is string)\n        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['cap'])\n          || request.resource.data.cap is string)\n        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['citta'])\n          || request.resource.data.citta is string)\n        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['provincia'])\n          || request.resource.data.provincia is string)\n        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['stato'])\n          || request.resource.data.stato is string)\n        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['numeroTelefono'])\n          || request.resource.data.numeroTelefono is string);\n\n      allow delete: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-09-04T16:10:58.358575Z","metadata":{"services":["cloud.firestore"]}}
